function l $create_array(l %size, l %elem_type) {
@start
    %size1 =l mul %size, %elem_type
    %ptr =l call $malloc(l %size1)
    jnz %ptr, @countinue, @failed

@countinue
    %size2 =l copy 32
    %header_pointer =l call $malloc(l %size2)
    jnz %ptr, @countinue2, @failed

@countinue2
    storel %ptr, %header_pointer

    %s1 = add %ptr, 8
    storel %s1, %elem_type

    %s2 = add %s1, 8
    storel %s2, %size

    %s3 = add %s2, 8
    storel %s3, 0
    
    ret %header_pointer 
    @failed
    ret 0
}
function $destroy_array(l %ptr) {
@start
    %s =l loadl %ptr
    call free(l %s)
    call free(%ptr)
}
